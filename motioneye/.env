# MotionEye Configuration Variables

# Docker Image Name
MOTIONEYE_IMAGE_NAME=motioneye-img

# Docker Container Name
MOTIONEYE_CONTAINER_NAME=motioneye

# Persistent Configuration Directory
MOTIONEYE_CONFIG_DIR=/home/user/motioneye/config

# Persistent Video Storage Directory
MOTIONEYE_VIDEO_DIR=/home/user/motioneye/videos
